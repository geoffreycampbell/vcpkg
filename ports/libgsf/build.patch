@@ -34,6 +34,26 @@
 
 static GObjectClass *parent_class;
 
+static gboolean
+gsf_input_stdio_stat (FILE *file, struct stat *st, gsf_off_t *size)
+{
+#ifdef _MSC_VER
+	struct _stat64 st64;
+
+	if (_fstat64 (fileno (file), &st64) < 0)
+		return FALSE;
+	*size = st64.st_size;
+	/* Keep the public struct stat ABI while obtaining a 64-bit file size. */
+	st->st_mode = st64.st_mode;
+	st->st_mtime = st64.st_mtime;
+#else
+	if (fstat (fileno (file), st) < 0)
+		return FALSE;
+	*size = st->st_size;
+#endif
+	return S_ISREG (st->st_mode);
+}
+
 struct _GsfInputStdio {
 	GsfInput input;
 
@@ -112,7 +132,7 @@ GsfInput *
