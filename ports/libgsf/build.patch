 {
 	GsfInputStdio *stdio;
-	struct stat st;
+	struct stat st = { 0 };
 	gsf_off_t size;
 
 	g_return_val_if_fail (filename != NULL, NULL);
 	g_return_val_if_fail (file != NULL, NULL);
 
-	if (fstat (fileno (file), &st) < 0 || !S_ISREG (st.st_mode)) {
+	if (!gsf_input_stdio_stat (file, &st, &size)) {
 		return make_local_copy (file, filename, NULL);
 	}
 
-	size = st.st_size;
-
 	stdio = g_object_new (GSF_INPUT_STDIO_TYPE, NULL);
 	stdio->file = file;
 	stdio->keep_open = keep_open;
@@ -257,7 +274,9 @@ gsf_input_stdio_seek (GsfInput *input, gsf_off_t offset, GSeekType whence)
 	GsfInputStdio const *stdio = GSF_INPUT_STDIO (input);
