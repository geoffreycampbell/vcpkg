 {
 	GsfInputStdio *input;
-	struct stat st;
+	struct stat st = { 0 };
 	FILE *file;
 	gsf_off_t size;
 
@@ -136,13 +156,12 @@ gsf_input_stdio_new (char const *filename, GError **err)
 		return NULL;
 	}
 
-	if (fstat (fileno (file), &st) < 0 || !S_ISREG (st.st_mode)) {
+	if (!gsf_input_stdio_stat (file, &st, &size)) {
 		GsfInput *res = make_local_copy (file, filename, err);
 		fclose (file);
 		return res;
 	}
 
-	size = st.st_size;
 	input = (GsfInputStdio *)g_object_new (GSF_INPUT_STDIO_TYPE, NULL);
 	input->file = file;
 	input->filename = g_strdup (filename);
@@ -172,18 +191,16 @@ GsfInput *
